<Project Sdk="Microsoft.NET.Sdk">
  <!--
    采集宿主（方案 B 的 Edge 进程）。
    net48 + x64：因为要加载大华 SDK 与原生 DLL；本身不引用任何厂商程序集，
    provider 通过 runtime\providers 目录反射加载。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DwsEdge.Host</RootNamespace>
    <AssemblyName>DwsEdge.Host</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DwsEdge.Core\DwsEdge.Core.csproj" />
  </ItemGroup>
</Project>
