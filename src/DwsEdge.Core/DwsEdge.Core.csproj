<Project Sdk="Microsoft.NET.Sdk">
  <!--
    厂商无关的核心契约与模型。
    同时面向 net48（采集宿主与插件）和 net10.0（业务平台），
    因此这里只能使用两个框架都支持的 BCL API，不要引入 Windows 专有依赖。
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>DwsEdge.Core</RootNamespace>
    <AssemblyName>DwsEdge.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
