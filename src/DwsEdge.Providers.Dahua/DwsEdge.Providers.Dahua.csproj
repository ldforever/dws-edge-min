<Project Sdk="Microsoft.NET.Sdk">
  <!--
    大华 DWS SDK 适配插件：唯一引用厂商程序集的工程。
    必须 net48 + x64：大华封装是 .NET Framework 4.0 目标，原生 DLL 只有 x64。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DwsEdge.Providers.Dahua</RootNamespace>
    <AssemblyName>DwsEdge.Providers.Dahua</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LogisticsBaseCSharp">
      <HintPath>..\..\runtime\LogisticsBaseCSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Private=false：不要把 Core 复制进 providers 目录，运行时统一用宿主根目录那一份 -->
    <ProjectReference Include="..\DwsEdge.Core\DwsEdge.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
