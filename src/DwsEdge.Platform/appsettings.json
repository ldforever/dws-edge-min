{
  "Urls": "http://0.0.0.0:8090",
  "Spool": {
    "Directory": "../spool",
    "PollIntervalMs": 500
  },
  "Images": {
    "Root": "../images",
    "MaxRecords": 5000
  },
  "Storage": {
    "ProbeIntervalSeconds": 300
  },
  "Runtime": {
    "Root": "..",
    "Tools": "tools",
    "PowerShell": "powershell.exe",
    "ConfigTimeoutSeconds": 240
  },
  "History": {
    "Directory": "../data",
    "LoadDays": 2
  },
  "Dedup": {
    "_说明": "B1 去重指纹归档：按 traceId 一条，定期把 WAL 合并进索引并清理过期项，避免长期运行文件膨胀",
    "Directory": "data/dedup",
    "RetentionDays": 30,
    "CompactWhenWalLines": 5000,
    "CompactEveryMinutes": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
